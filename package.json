{
  "name": "dsh-daily-mode",
  "version": "1.2.1",
  "private": false,
  "type": "module",
  "description": "Daily mode with native tools, configurable child agents, and explicit context presentation.",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./context-trim": "./plugins/dsh-context-trim/lib/index.js",
    "./agent-control": "./plugins/dsh-agent-control/lib/index.js",
    "./policy": "./lib/policy.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./plugins/dsh-agent-archive-filter/cordis.patch.yml",
        "./plugins/dsh-session-cleanup/cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": ">=0.1.7",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7",
