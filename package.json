    "@deepseek-ai/dsh-permission-presets": ">=0.1.7",
    "@deepseek-ai/dsh-llm": ">=0.1.7",
    "@deepseek-ai/dsh-session": ">=0.1.7",
    "@deepseek-ai/dsh-tool-skill": ">=0.1.7",
    "@deepseek-ai/dsh-agent-instructions": ">=0.1.7",
    "@deepseek-ai/dsh-tool-goal": ">=0.1.7",
    "@deepseek-ai/dsh-goal-round-driver": ">=0.1.7",
    "@deepseek-ai/dsh-goal": ">=0.1.7",
    "@deepseek-ai/dsh-subagent": ">=0.1.7",
    "@deepseek-ai/dsh-session-query": ">=0.1.7",
    "@deepseek-ai/dsh-workspace": ">=0.1.7",
    "@deepseek-ai/dsh-util-values": ">=0.1.7",
    "@deepseek-ai/dsh-settings": ">=0.1.7",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7",
